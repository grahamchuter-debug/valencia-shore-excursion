{
  // WORKERS STATIC ASSETS — Valencia Shore Excursions (ADR-0001)
  // Apex custom_domain only. www → apex via Cloudflare Redirect Rules.
  "name": "valencia-shore-excursions",
  "compatibility_date": "2026-07-17",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "valenciashoreexcursion.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
