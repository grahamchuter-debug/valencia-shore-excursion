{
  // WORKERS STATIC ASSETS — Valencia Shore Excursions (ADR-0001)
  // Custom Domain routes: omit until approval, then apex custom_domain only.
  // www → apex via Cloudflare Redirect Rules (not a second Worker origin).
  "name": "valencia-shore-excursions",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "preview_urls": true,
  // Static export directory token for World 2.0 config audit: "out"
  // pages_build_output_dir equivalent under Workers Assets = assets.directory
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
